# ===== video-dewatermark Docker 部署可选配置 =====
# 用前先复制成仓库根的 .env 再按需修改：
#   cp docker/.env.example .env
# 所有项都有缺省值，不配也能直接 `docker compose up -d --build` 起站。

# 对外端口（nginx，默认 8080；与 systemd 方案共用同一默认端口）
VD_PORT=8080

# ---- 海外机房时，给特定平台指定国内出口代理 ----
# 平台代理按 <平台大写>_PROXY 命名，只对该平台生效；PARSE_PROXY 对所有平台兜底。
# 支持 http:// 与 socks5:// / socks5h://（SOCKS5 依赖 socksio，已随镜像安装）。
# 例如：BILI_PROXY=http://user:pass@your-http-proxy:7890
#      MIYOUSHE_PROXY=socks5h://your-socks5-exit:1080   # socks5h=域名交代理远端解析
# 提示：B站/米游社对海外 IP 风控（B站 HTTP 412、米游社连接超时），海外部署建议配置
#（国内机器可全部留空走直连）
PARSE_PROXY=
BILI_PROXY=
DOUYIN_PROXY=
XIAOHONGSHU_PROXY=
MIYOUSHE_PROXY=
WEIBO_PROXY=

# ---- HLS(m3u8) 转封装 ----
# A站、央视网长节目等只提供 HLS(m3u8) 源；媒体代理会调用镜像内置的 ffmpeg
# 把它转封装成 mp4（-c copy，不重编码），预览与下载都直接得到 mp4。
# 默认开启；设 0 关闭（关闭后 HLS 源原样转发，浏览器 <video> 无法直接播放）。
HLS_TRANSCODE=1
# 指定 ffmpeg 二进制路径（默认用镜像内安装的 ffmpeg）
FFMPEG_BIN=ffmpeg
# 转存缓存：完整 mp4 的缓存目录与保留时长（秒），用于支持拖动进度条（seek）。
# 留空则用容器内默认目录 /app/data/hls
HLS_CACHE_PATH=
HLS_CACHE_TTL_SEC=3600
# 转存的全局并发上限（每个转存 = 一个 ffmpeg 进程，防止并发下载打满 CPU/磁盘）
HLS_TRANSCODE_CONCURRENCY=2
# 单次转存时间上限（秒）：上游异常慢时放弃转存、回退流式
HLS_TRANSCODE_TIMEOUT_SEC=600

# ---- 抖音原生详情兜底（可选）----
# 分享页未内嵌作品数据时，用你自己的抖音登录 Cookie 走 web 详情接口兜底解析
# （内置自实现的 a_bogus 签名）。留空 = 不启用该兜底。
# ⚠️ 这是敏感凭据：仅填你自己的账号，切勿提交到仓库或使用他人 Cookie。
DOUYIN_COOKIE=

# ---- 客户端 IP 头信任（裸部署必看）----
# 默认 1：信任反向代理写入的 X-Real-IP / X-Forwarded-For。
# 推荐部署形态是 nginx 反代（nginx 用 proxy_set_header 覆盖该头，客户端伪造无效）。
# 若前面没有反向代理（直接暴露后端端口），请设为 0 ——
# 否则客户端可伪造 X-Real-IP 把限流桶键变成可控值，从而绕过按 IP 限流。
GUARD_TRUST_PROXY_HEADERS=1

# ---- 健康巡检告警（可选，参考 ops/healthcheck.py）----
# 告警需要时再配，不需要就全部留空（仅写文件不发消息）
SITE_URL=
ALERT_WEBHOOK=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=